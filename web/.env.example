# Copy to .env.local for local overrides. Never commit secrets.
# mock = in-browser demo API with synthetic data (default)
# http = call the Rails API (api/) at VITE_API_URL
VITE_API_MODE=mock
VITE_API_URL=
# true = show the demo menu (fault injection, reset) against a backend with AUTH_MODE=demo
VITE_DEMO_CONTROLS=false
